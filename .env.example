# ─────────────────────────────────────────────────────────────────────────
# Ghostwriter → Bludit publishing credentials
# Copy this file to ".env" and fill in the real values. Never commit ".env".
# ─────────────────────────────────────────────────────────────────────────

# Base URL of your Bludit site's API endpoint.
# The API plugin exposes everything under {site}/api/
# For tap.keg.dev this is:
BLUDIT_API_URL=https://tap.keg.dev/api

# API Token (READ token).
# Where to find it: Bludit admin → Plugins → API → Settings → "API Token".
# NOTE: this token is regenerated every time the API plugin is (re)installed.
BLUDIT_API_TOKEN=

# Authentication Token (WRITE token — grants create/edit/delete).
# Where to find it: Bludit admin → Users → (your admin user) → tab "Security"
#   → "Authentication Token".
# Must belong to a user with the "admin" role, or writes are rejected.
BLUDIT_AUTH_TOKEN=
